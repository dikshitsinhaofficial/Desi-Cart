# ──────────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this to .env for local development.
# On Vercel, add these in the project's Environment Variables dashboard.
# ──────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Razorpay credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# CORS — set to your Vercel frontend URL in production
# e.g. FRONTEND_URL=https://desi-cart.vercel.app
FRONTEND_URL=
